# Copy to .env for local development. `make dev` / docker-compose read these.
DATABASE_URL=postgres://app:app@localhost:5432/app
# `make test` points #[sqlx::test] here instead: same server, but its bookkeeping
# schema stays out of the dev `app` database. (A bare `cargo test` reads
# DATABASE_URL above via .env — works, but writes that schema into `app`.)
TEST_DATABASE_URL=postgres://app:app@localhost:5432/postgres
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=dev
# Max size of the Postgres connection pool.
APP_DB_MAX_CONNECTIONS=10
# Allowed browser origin for the Vite dev server (CORS, dev only).
APP_CORS_ORIGIN=http://localhost:5173
# Dev-only JWT signing/verification secret (HS256). Used only when APP_JWT_ISSUER
# is unset. Rotate for real deployments.
APP_JWT_SECRET=dev-only-insecure-secret-change-me
# Production JWT: set APP_JWT_ISSUER to an OIDC issuer to verify tokens against its
# published keys (JWKS), discovered at {issuer}/.well-known/openid-configuration.
# This replaces the HS256 secret path (verify-only; no token issuance). Optionally
# set APP_JWT_AUDIENCE to require a matching `aud` claim.
# APP_JWT_ISSUER=https://your-tenant.example.auth0.com/
# APP_JWT_AUDIENCE=https://api.example.com
RUST_LOG=info,sqlx=warn
# sqlx compiles against the checked-in .sqlx cache by default (no live DB needed).
SQLX_OFFLINE=true
