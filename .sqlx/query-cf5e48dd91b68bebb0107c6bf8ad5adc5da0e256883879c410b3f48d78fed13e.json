  "db_name": "PostgreSQL",
  "query": "\n            UPDATE messaging.job SET attempts = attempts + 1, run_at = $2\n            WHERE id = (\n                SELECT id FROM messaging.job\n                WHERE dead_at IS NULL AND run_at <= $1\n                ORDER BY run_at, id\n                LIMIT 1\n                FOR UPDATE SKIP LOCKED\n            )\n            RETURNING id, queue, payload, attempts, max_attempts\n            ",
