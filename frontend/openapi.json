  "components": {
    "schemas": {
      "ChangeDisplayNameRequest": {
        "type": "object",
        "title": "ChangeDisplayNameRequest",
        "description": "Request body for changing the current user's display name. Carries no\nversion: the concurrency token travels only in the `If-Match` header.",
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      },
      "CreateNoteRequest": {
        "type": "object",
        "title": "CreateNoteRequest",
        "required": [
          "authorId",
          "title"
        ],
        "properties": {
          "authorId": {
            "type": "string",
            "description": "Author id: the uuid of a registered user."
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "default": ""
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "title": "CreateUserRequest",
        "description": "Request body for creating a user.",
        "required": [
          "email",
          "displayName"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "EditNoteRequest": {
        "type": "object",
        "title": "EditNoteRequest",
        "description": "Replaces a note's title and body. Carries no version: the concurrency token\ntravels only in the `If-Match` header, never the body (see the handlers).",
        "required": [
          "title",
          "body"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "title": "ErrorBody",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "description": "Branch on this, not on `message`.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              },
              {
                "description": "Branch on this, not on `message`."
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "requestId": {
            "type": "string",
            "description": "The same id as the `x-request-id` header."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation_error",
          "malformed_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "conflict",
          "unsupported_media_type",
          "precondition_required",
          "precondition_failed",
          "internal_error"
        ]
      },
      "FieldError": {
        "type": "object",
        "title": "FieldError",
        "description": "One input at fault. `path` names it as the client sent it (e.g. `title`).",
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ListResult_NoteResponse": {
        "type": "object",
        "title": "ListResult_NoteResponse",
        "description": "The paging fields are present only when the list was paged.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Matching items across all pages."
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "description": "The `limit` that was applied (after clamping)."
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ListResult_NoteSummaryResponse": {
        "type": "object",
        "title": "ListResult_NoteSummaryResponse",
        "description": "The paging fields are present only when the list was paged.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteSummaryResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Matching items across all pages."
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "description": "The `limit` that was applied (after clamping)."
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ListResult_UserResponse": {
        "type": "object",
        "title": "ListResult_UserResponse",
        "description": "The paging fields are present only when the list was paged.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Matching items across all pages."
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "description": "The `limit` that was applied (after clamping)."
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "NoteResponse": {
        "type": "object",
        "title": "NoteResponse",
        "required": [
          "id",
          "authorId",
          "title",
          "body",
          "createdAt",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "authorId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Optimistic-concurrency version. Echo it back in `If-Match` to edit this\nnote; a stale value is refused with `412 Precondition Failed`. Also\nmirrored in the `ETag` response header for single-item reads."
          }
        }
      },
      "NoteSort": {
        "type": "string",
        "enum": [
          "title",
          "-title",
          "createdAt",
          "-createdAt"
        ]
      },
      "NoteSummaryResponse": {
        "type": "object",
        "title": "NoteSummaryResponse",
        "required": [
          "id",
          "title",
          "authorId",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "authorId": {
            "type": "string"
          },
          "authorName": {
            "type": "string",
            "description": "The author's display name; absent when no user has the note's author id."
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "NoteSummarySort": {
        "type": "string",
        "enum": [
          "title",
          "-title",
          "authorName",
          "-authorName",
          "createdAt",
          "-createdAt"
        ]
      },
      "UserResponse": {
        "type": "object",
        "title": "UserResponse",
        "description": "A user as exposed over HTTP. Ids and timestamps are strings so the generated\nclient stays dependency-free (uuid/RFC3339 as plain `string`).",
        "required": [
          "id",
          "email",
          "displayName",
          "createdAt",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Optimistic-concurrency version. Echo it back in `If-Match` to change this\nuser; a stale value is refused with `412 Precondition Failed`. Also\nmirrored in the `ETag` response header for single-item reads."
          }
        }
      },
      "UserSort": {
        "type": "string",
        "enum": [
          "email",
          "-email",
          "displayName",
          "-displayName",
          "createdAt",
          "-createdAt"
        ]
      }
    },
    "securitySchemes": {
      "JwtAuth": {
        "type": "http",
        "description": "JWT Bearer security scheme. Apply as an operation parameter to guard a route:\nthe extracted [`Claims`] identify the caller.",
        "scheme": "bearer"
      }
    }
