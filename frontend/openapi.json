    "/note-search": {
      "get": {
        "tags": [
          "NoteSearch"
        ],
        "summary": "Search notes, each with its author's name, paginated. `q` matches\ncase-insensitively anywhere in a note's title or its author's name; omit\nit to list every note. Most-recent first unless `sort` says otherwise:\nrepeat it to sort by several keys, `-` prefix for descending.",
        "parameters": [
          {
            "name": "q",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "limit",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
